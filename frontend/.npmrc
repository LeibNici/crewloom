# 项目级 pnpm 配置。
#
# store-dir 指向仓库内目录，避免写入用户全局 store（本机 ~/Library/pnpm 在
# 受限沙箱下不可写）。node-linker=isolated 使用 pnpm 默认的隔离 node_modules。
store-dir=.pnpm-store
node-linker=isolated
strict-peer-dependencies=false

# public-hoist-pattern=* （即 shamefully-hoist 的等价写法）：
# `vendor/nocobase-2.2.22/**` 里的 NocoBase 2.2.22 固定源码在 pnpm 隔离布局的
# node_modules **之外**，它的裸包 import（@codemirror/*、quill、vditor、mermaid、
# antd-mobile、@ant-design/pro-layout、mathjs、ses… 共 70+ 个）在 isolated 布局下
# 只能从 `.pnpm/<hash>/node_modules`（包自己的依赖）解析，从仓库根解析不到。
# Vite 的 dev 预打包（optimizeDeps）以项目根为基准解析这些包，因此必须把它们
# 公开提升到 `frontend/node_modules`；否则开发生成器报
# `Failed to resolve dependency: …`（见 09 §4.3）。构建侧同样依赖该解析结果。
# 该选项只影响本项目安装布局，不写全局 ~/.npmrc。
public-hoist-pattern[]=*

# 包源：NocoBase 原生组件依赖里 @nocobase/evaluators@2.2.22 在 npmmirror 上缺失
# （镜像 latest 停在 2.2.21），而 @nocobase/client@2.2.22 硬依赖它；只对本工程改用官方源，
# 不改全局 ~/.npmrc，也不影响其它工程。归档实验 experiments/native-reuse/.npmrc 同样处理。
registry=https://registry.npmjs.org
