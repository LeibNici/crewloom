{
  "name": "crewloom-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Crewloom 自有前端（P1：公共框架、登录、导航、角色与权限对接）",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "verify:backend": "node scripts/verify-backend.mjs",
    "verify:13000": "node scripts/verify-13000-readonly.mjs",
    "verify:public": "node scripts/probe-public-13000.mjs",
    "verify:public:browser": "node scripts/verify-public-browser.mjs",
    "test:live": "CREWLOOM_LIVE_TESTS=1 vitest run",
    "verify:browser": "node scripts/browser-check.mjs",
    "verify:browser:controlled": "node scripts/browser-check-controlled.mjs",
    "verify:fixtures": "node scripts/setup-fixtures.mjs",
    "check:native-entries": "node scripts/check-native-entries.mjs",
    "test:live:backend": "CREWLOOM_LIVE_TESTS=1 vitest run tests/live-backend.test.ts"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@ant-design/x": "1.6.1",
    "@dicebear/core": "9.2.3",
    "@dicebear/notionists": "9.2.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "@formily/core": "2.3.7",
    "@formily/react": "2.3.7",
    "@nocobase/ai-employee-avatars": "1.0.2",
    "@nocobase/client": "2.2.22",
    "@nocobase/client-v2": "2.2.22",
    "@nocobase/evaluators": "2.2.22",
    "@nocobase/flow-engine": "2.2.22",
    "@nocobase/plugin-acl": "2.2.22",
    "@nocobase/plugin-ai": "2.2.22",
    "@nocobase/plugin-file-manager": "2.2.22",
    "@nocobase/plugin-workflow": "2.2.22",
    "@nocobase/plugin-workflow-action-trigger": "2.2.22",
