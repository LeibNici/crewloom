    "@nocobase/plugin-workflow-json-variable-mapping": "2.2.22",
    "@nocobase/plugin-workflow-loop": "2.2.22",
    "@nocobase/plugin-workflow-mailer": "2.2.22",
    "@nocobase/plugin-workflow-manual": "2.2.22",
