    "@nocobase/utils": "link:./vendor/nocobase-utils-client",
    "@nocobase/utils-native": "npm:@nocobase/utils@2.2.22",
    "@swc/helpers": "0.5.23",
    "@tanstack/react-query": "5.104.1",
    "@xyflow/react": "12.8.6",
    "ahooks": "3.10.0",
